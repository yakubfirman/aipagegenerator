# ============================================================
# Root .htaccess - Laravel App
# Redirect semua request ke folder /public
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Arahkan semua request ke folder public/
    RewriteRule ^$ public/ [L]
    RewriteRule ((?s).*) public/$1 [L]
</IfModule>
